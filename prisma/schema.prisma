datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Institution {
  id                         String   @id @default(uuid())
  nombre                     String
  logo_url                   String?
  nombre_docente_responsable String?
  plan_activo                Boolean  @default(false)
  createdAt                  DateTime @default(now())

  students InstitutionStudent[]
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?
  role      String   @default("USUARIO") // USUARIO | INSTITUCION | SUPER_ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institutions     InstitutionStudent[]
  certificates     Certificate[]
  courseProgresses CourseProgress[]
  recognitions     Recognition[]
  sessions         Session[]
}

model InstitutionStudent {
  id            String @id @default(uuid())
  institutionId String
  userId        String

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
}

model Course {
  id         String  @id @default(uuid())
  es_muestra Boolean @default(false)
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MonetizationConfig {
  id                       String   @id @default("default")
  kofiUrl                  String?
  paypalUrl                String?
  subscriptionPriceDisplay String   @default("$9.99 USD/mes")
  updatedAt                DateTime @updatedAt
}

model Recognition {
  id               String   @id @default(uuid())
  recognitionCode  String   @unique
  usuario_id       String
  curso_id         String
  institucion_id   String?
  logo_institucion String?
  nombre_docente   String?
  fecha_emision    DateTime @default(now())

  user User @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
}

model CourseProgress {
  id                String          @id @default(uuid())
  userId            String
  courseId          String
  status            String          @default("IN_PROGRESS")
  startDate         DateTime        @default(now())
  completionDate    String?
  finalGradePercent Float?
  certificateUuid   String?
  approvedBy        String?
  approvalDate      String?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts LessonAttempt[]

  @@unique([userId, courseId])
}

model LessonAttempt {
  id                 String    @id @default(uuid())
  courseProgressId   String
  lessonId           String
  attemptsCount      Int       @default(1)
  hintsUnlockedCount Int       @default(0)
  timeSpentSeconds   Int       @default(0)
  scoreObtained      Float     @default(0)
  functionalScore    Float     @default(0)
  efficiencyScore    Float     @default(0)
  timeScore          Float     @default(0)
  passed             Boolean   @default(false)
  completedAt        DateTime?
  submittedCode      String

  courseProgress CourseProgress @relation(fields: [courseProgressId], references: [id], onDelete: Cascade)

  @@unique([courseProgressId, lessonId])
}

model Certificate {
  uuid              String   @id
  userId            String?
  studentName       String
  courseId          String
  courseTitle       String
  finalGradePercent Float
  studyHours        Int
  issueDate         String
  approvedBy        String?  @default("Quiroz Systems Admin")
  createdAt         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
